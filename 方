                    tr.className = "hover:bg-slate-50/80 transition-colors";
                    let rowHtml = `<td class="p-3 font-bold text-center text-slate-600 bg-slate-50 text-xs">${row.period}<br><span class="text-[10px] font-normal text-slate-400">${row.time}</span></td>`;

                    ['mon', 'tue', 'wed', 'thu', 'fri'].forEach((dayKey, idx) => {
                        const course = row[dayKey];
                        const isTodayCol = (idx + 1) === today;

                        if (course && course.type !== 'free') {
                            // Check filter
                            const match = filterText === '' || 
                                course.name.includes(filterText) || 
                                course.teacher.includes(filterText) || 
                                course.room.includes(filterText);

                            let badgeBg = "bg-nursing-50 text-nursing-800 border-nursing-200";
                            if (course.type === 'lab') badgeBg = "bg-teal-50 text-teal-800 border-teal-200";
                            if (course.type === 'gen') badgeBg = "bg-amber-50 text-amber-800 border-amber-200";
                            if (course.type === 'class') badgeBg = "bg-rose-50 text-rose-800 border-rose-200";

                            rowHtml += `
                                <td class="p-2 border border-slate-100 text-center ${isTodayCol ? 'bg-nursing-50/30' : ''} ${!match ? 'opacity-20' : ''}">
                                    <div class="p-2 rounded-xl border ${badgeBg} shadow-2xs space-y-1">
                                        <div class="font-bold text-xs">${course.name}</div>
                                        <div class="text-[11px] opacity-80">${course.room} • ${course.teacher}</div>

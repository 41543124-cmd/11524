                            rowHtml += `<td class="p-2 border border-slate-100 text-center text-slate-300 text-xs ${isTodayCol ? 'bg-nursing-50/20' : ''}">—</td>`;
                        }
                    });

                    tr.innerHTML = rowHtml;
                }

                tbody.appendChild(tr);
            });
        }


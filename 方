                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-1">體重 (kg)</label>
                                <input type="number" id="bmi-weight" placeholder="例如：58" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-nursing-500 focus:border-nursing-500 outline-none text-slate-800">
                            </div>
                            <button onclick="calculateBMI()" class="w-full py-3 bg-nursing-600 hover:bg-nursing-700 text-white font-bold rounded-xl shadow-md transition-all duration-200 flex items-center justify-center gap-2">

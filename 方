        function renderTimetable(filterText = '') {
            const tbody = document.getElementById('timetable-body');
            tbody.innerHTML = '';

            // Get current day of week (0: Sun, 1: Mon, ..., 5: Fri, 6: Sat)
            const today = new Date().getDay();
            const daysMap = { 1: 'th-mon', 2: 'th-tue', 3: 'th-wed', 4: 'th-thu', 5: 'th-fri' };
            
            // Highlight today column header
            Object.values(daysMap).forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.remove('bg-nursing-100', 'text-nursing-900');
            });
            if (daysMap[today]) {
                const activeTh = document.getElementById(daysMap[today]);
                if (activeTh) activeTh.classList.add('bg-nursing-100', 'text-nursing-900');
            }

            timetableData.forEach(row => {
                const tr = document.createElement('tr');

                if (row.isRest) {
                    tr.className = "bg-slate-50 text-center text-xs font-bold text-slate-400";
                    tr.innerHTML = `
                        <td class="p-3 bg-slate-100">${row.period}<br>${row.time}</td>
                        <td colspan="5" class="p-3 tracking-widest uppercase">── 午 休 時 間 ──</td>
                    `;

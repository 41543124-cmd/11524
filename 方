                            </button>
                        </div>

                        <!-- Result Display Box -->
                        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 flex flex-col justify-between">
                            <div>
                                <h4 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-4">計算結果分析</h4>

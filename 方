        // TOOL 1: BMI & BSA
        function calculateBMI() {
            const h = parseFloat(document.getElementById('bmi-height').value);
            const w = parseFloat(document.getElementById('bmi-weight').value);

            if (!h || !w || h <= 0 || w <= 0) {
                alert('請輸入有效的身高與體重數字！');
                return;
            }

            const bmi = (w / ((h / 100) * (h / 100))).toFixed(1);
            const bsa = Math.sqrt((h * w) / 3600).toFixed(2);

            document.getElementById('res-bmi').innerText = bmi;
            document.getElementById('res-bsa').innerHTML = `${bsa} <span class="text-xs font-normal">m²</span>`;

            const statusEl = document.getElementById('res-bmi-status');
            const adviceEl = document.getElementById('res-bmi-advice');

            if (bmi < 18.5) {
                statusEl.className = "inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800";
                statusEl.innerText = "體重過輕 (Underweight)";
                adviceEl.innerText = "建議均衡飲食，適度補充蛋白質與熱量，並保持规律運動。";
            } else if (bmi >= 18.5 && bmi < 24) {
                statusEl.className = "inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800";
                statusEl.innerText = "健康體位 (Normal)";
                adviceEl.innerText = "恭喜！體重維持於良好範圍，請繼續保持健康的作息與運動習慣。";
            } else if (bmi >= 24 && bmi < 27) {
                statusEl.className = "inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800";
                statusEl.innerText = "體重過重 (Overweight)";
                adviceEl.innerText = "建議調整飲食結構，減少高油脂與精製糖攝取，增加有氧運動。";
            } else {
                statusEl.className = "inline-block px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800";
                statusEl.innerText = "肥胖 (Obesity)";
                adviceEl.innerText = "建議至營養科或健康管理門診進行諮詢，制定個人化飲食與運動計畫。";
            }
        }

        // TOOL 2: IV DRIP RATE
        function calculateIV() {
            const vol = parseFloat(document.getElementById('iv-volume').value);
            const hrs = parseFloat(document.getElementById('iv-hours').value);
            const factor = parseFloat(document.getElementById('iv-factor').value);

            if (!vol || !hrs || vol <= 0 || hrs <= 0) {
                alert('請輸入正確的輸液量與時間！');
                return;
            }

            const totalMins = hrs * 60;
            const gttMin = Math.round((vol * factor) / totalMins);
            const secPerDrop = gttMin > 0 ? (60 / gttMin).toFixed(1) : 0;
            const mlHr = Math.round(vol / hrs);

            document.getElementById('res-iv-gtt').innerHTML = `${gttMin} <span class="text-sm font-bold">gtt/min</span>`;
            document.getElementById('res-iv-sec').innerText = `（約每 ${secPerDrop} 秒 1 滴）`;
            document.getElementById('res-iv-mlhr').innerHTML = `${mlHr} <span class="text-xs font-normal">mL/hr</span>`;
        }

        // TOOL 3: EDD CALCULATOR
        function calculateEDD() {
            const lmpVal = document.getElementById('edd-lmp').value;
            if (!lmpVal) {
                alert('請選擇最後一次月經日期 (LMP)！');
                return;
            }

            const lmpDate = new Date(lmpVal);
            // Naegele's rule: + 280 days
            const eddDate = new Date(lmpDate.getTime() + 280 * 24 * 60 * 60 * 1000);

            const year = eddDate.getFullYear();
            const month = String(eddDate.getMonth() + 1).padStart(2, '0');
            const day = String(eddDate.getDate()).padStart(2, '0');

            document.getElementById('res-edd-date').innerText = `${year} 年 ${month} 月 ${day} 日`;
        }

        // TOOL 4: GCS CALCULATOR
        function calculateGCS() {
            const e = document.getElementById('gcs-e').value;
            const vVal = document.getElementById('gcs-v').value;
            const m = document.getElementById('gcs-m').value;

            let vScore = parseInt(vVal);
            let isIntubated = false;

            if (vVal === '1-intubated') {
                vScore = 1;
                isIntubated = true;
            }

            const eScore = parseInt(e);
            const mScore = parseInt(m);
            const total = eScore + (isIntubated ? 0 : vScore) + mScore;

            const scoreCode = `E${eScore}V${isIntubated ? 't' : vScore}M${mScore}`;
            document.getElementById('res-gcs-score').innerText = scoreCode;
            document.getElementById('res-gcs-num').innerText = isIntubated ? `${eScore + mScore}+Vt` : total;

            const levelEl = document.getElementById('res-gcs-level');

            if (isIntubated) {
                levelEl.innerText = "已行氣管內插管 (Intubated)";
                levelEl.className = "text-base font-extrabold text-amber-600 mt-0.5";
            } else if (total >= 13) {
                levelEl.innerText = "意識清醒 / 輕度損傷 (Mild)";
                levelEl.className = "text-base font-extrabold text-emerald-600 mt-0.5";
            } else if (total >= 9) {
                levelEl.innerText = "中度昏迷 / 中度損傷 (Moderate)";
                levelEl.className = "text-base font-extrabold text-amber-600 mt-0.5";
            } else {
                levelEl.innerText = "重度昏迷 / 嚴重損傷 (Severe)";
                levelEl.className = "text-base font-extrabold text-rose-600 mt-0.5";
            }
        }


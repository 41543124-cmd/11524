                    <img src="${m.avatar}" alt="${m.name}" class="w-16 h-16 rounded-full object-cover border-2 border-nursing-200">
                    <div>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${m.tag === '幹部' ? 'bg-nursing-100 text-nursing-800' : 'bg-slate-100 text-slate-600'}">${m.role}</span>
                        <h4 class="font-bold text-slate-800 text-sm mt-1">座號 ${m.no} - ${m.name}</h4>
                    </div>
                    <p class="text-xs text-slate-500 italic leading-snug">"${m.quote}"</p>
                </div>
            `).join('');
        }

        function filterMembers() {
            const val = document.getElementById('member-search').value.trim();
            renderMembers(val);
        }

        // INITIAL ON LOAD
        window.onload = function() {
            renderTimetable();
            renderHomeTodaySchedule();
            renderEvents();
            renderTodos();
            renderMembers();
            calculateGCS();
        };
    </script>
</body>
</html>
